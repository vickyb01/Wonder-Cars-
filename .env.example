# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Dashboard Authentication (defaults provided for local preview if unset)
ADMIN_EMAIL="admin@stradamotors.in"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
JWT_SECRET="CHANGE_ME_JWT_SECRET"

# Optional Cloudinary Image Storage (uses local disk /uploads when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps Platform API Key (automatically injected when provisioned in AI Studio)
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# Lead Notification Email Destination (Forms send new lead details here)
LEAD_NOTIFICATION_EMAIL="vickybhelave25@navgurukul.org"

# Optional SMTP Settings for Live Email Delivery (e.g. Gmail SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-digit-gmail-app-password"
# SMTP_FROM="Wonder Cars Leads <leads@wondercars.in>"

