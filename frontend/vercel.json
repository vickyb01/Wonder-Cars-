{
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/car-page.mjs": {
      "includeFiles": "dist/spa-fallback.html",
      "maxDuration": 10
    },
    "api/not-found.mjs": {
      "includeFiles": "dist/spa-fallback.html",
      "maxDuration": 10
    },
    "api/sitemap.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/src/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/compare",
      "destination": "/cars",
      "permanent": true
    },
    {
      "source": "/sell",
      "destination": "/cars",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/about#gallery",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "https://wonder-cars-1.onrender.com/uploads/:path*"
    },
    {
      "source": "/api/((?!mail-relay|car-page|sitemap|not-found).*)",
      "destination": "https://wonder-cars-1.onrender.com/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/cars",
      "destination": "/cars.html"
    },
    {
      "source": "/cars/:id",
      "destination": "/api/car-page?id=:id"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|uploads/|sitemap\\.xml$|robots\\.txt$).+)",
      "destination": "/api/not-found"
    }
  ]
}
